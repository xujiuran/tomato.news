# Server Port (default 3000)
PORT=3000

# Server Host Binding (0.0.0.0 allows external / Docker container access)
HOST=0.0.0.0

# Environment (development | production)
NODE_ENV=production

# 知乎热榜 Cookie（可选）
# 不带 cookie 时会自动降级到公开接口；带 cookie 数据更全、更稳定
# 获取方式：浏览器登录知乎 → F12 → 复制请求头的 cookie 值
# 注意：cookie 会过期（通常 2~6 个月），过期后重新获取并更新
ZHIHU_COOKIE=
